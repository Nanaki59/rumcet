{
  "name": "rumcet",
  "version": "1.0.0",
  "main": "dist/src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "tsc -w",
    "build": "tsc && tsc -p tsconfig.preload.json && npm run copy-html && npm run copy-wasm",
    "copy-html": "copyfiles -f \"src/renderer/*.html\" \"src/renderer/*.css\" dist/src/renderer",
    "copy-wasm": "echo 'No WASM files to copy'",
    "clean": "rimraf dist",
    "sync-systems": "tsc && node scripts/generateSystems.mjs",
    "check-naming": "node scripts/checkRomNaming.mjs",
    "dist": "npm run clean && npm run build && electron-builder"
  },
  "keywords": [
    "rom",
    "manager",
    "electron",
    "dat",
    "no-intro",
    "redump",
    "mame"
  ],
  "author": "Nanaki59",
  "license": "AGPL-3.0-or-later",
  "description": "ROM's Ultimate Manager, Conversion and Editor Tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rumcet.git"
  },
  "build": {
    "appId": "io.github.nanaki59.rumcet",
    "productName": "RUMCET",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "locales/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${platform}-${arch}",
        "to": "bin/${platform}-${arch}"
      }
    ],
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/7zip-bin/{mac,linux}/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "files": [
        "!node_modules/7zip-bin/{win,mac}/**"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "files": [
        "!node_modules/7zip-bin/{win,linux}/**"
      ]
    }
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "crc": "^4.3.2",
    "node-7z": "^3.0.0",
    "sqlite3": "^5.1.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.1.0",
    "@types/node-7z": "^2.1.10",
    "@types/sqlite3": "^3.1.11",
    "@types/xml2js": "^0.4.14",
    "copyfiles": "^2.4.1",
    "electron": "^37.2.3",
    "electron-builder": "^26.15.3",
    "rimraf": "^5.0.10",
    "typescript": "^5.8.3"
  }
}
